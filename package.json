{
  "name": "taskly-api",
  "version": "1.0.0",
  "description": "Production-ready task management REST API — Fastify, Prisma, PostgreSQL, JWT auth",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.12.0",
    "bcrypt": "^5.1.1",
    "fastify": "^4.27.0",
    "fastify-type-provider-zod": "^1.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "prisma": "^5.12.0",
    "tsx": "^4.8.2",
    "typescript": "^5.4.4",
    "vitest": "^1.5.0"
  },
  "engines": { "node": ">=20" }
}
